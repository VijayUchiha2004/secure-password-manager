NODE_ENV=production
PORT=3000
HOST=0.0.0.0

DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-mysql-user
DB_PASSWORD=your-mysql-password
DB_NAME=password_manager
DB_SSL=false
# Set to true for Aiven and other managed databases that require TLS.
DB_SSL_REJECT_UNAUTHORIZED=true
# Optional CA certificate. Store it as one line with literal \n separators.
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-64-hex-characters

# Optional when the frontend is hosted on a different origin.
# CORS_ORIGIN=https://your-frontend.example.com
